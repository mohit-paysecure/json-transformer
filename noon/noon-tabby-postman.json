    {
      "name": "3. Get Order",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/payment/v1/order/{{orderId}}?verbose=true",
          "host": ["{{baseUrl}}"],
          "path": ["payment", "v1", "order", "{{orderId}}"],
          "query": [
            { "key": "verbose", "value": "true", "description": "Optional. Set to true for full order/transaction detail. Omit for the default lighter payload." }
          ]
        },
        "description": "Step 5 of the BNPL flow. Call after the customer returns from Tabby to `returnUrl` / the webhook fires, to retrieve the final order status (`result.order.status`: INITIATED / SUCCESS / FAILED / CAPTURED).\n\nNote: do not poll this endpoint for reconciliation - noon payments throttles that usage pattern."
      },
